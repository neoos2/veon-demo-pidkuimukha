---
// Functional line icons only (concept.md «Изображения»): 1.5 px stroke in the current text colour.
interface Props { name: "phone" | "telegram" | "arrow" | "route" | "menu" | "close"; size?: number; class?: string }
const { name, size = 20, class: cls } = Astro.props;
const paths: Record<Props["name"], string> = {
  phone: "M5.5 3.5h3l1.5 4-2 1.2a11 11 0 0 0 5.3 5.3l1.2-2 4 1.5v3a2 2 0 0 1-2 2A15.5 15.5 0 0 1 3.5 5.5a2 2 0 0 1 2-2Z",
  telegram: "M21 4 3 11.2l6.2 2.2L18 7.5l-6.8 7.3.3 5.2 3.1-3.6 4 3L21 4Z",
  arrow: "M4 12h15m-5-5 5 5-5 5",
  route: "M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11Zm0-8.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z",
  menu: "M4 7h16M4 12h16M4 17h16",
  close: "M6 6l12 12M18 6 6 18",
};
---
<svg class:list={["icon", cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={paths[name]} /></svg>
