---
import logoLight from "../assets/img/logo-light.svg";
import FutureLink from "./FutureLink.astro";
import { clinic, phones, links, SOON } from "../data/clinic";
---
<footer class="site-footer on-dark">
  <div class="container site-footer__grid">
    <a class="site-footer__logo" href="#top" aria-label="DR. PIDKUIMUKHA — на початок сторінки">
      <img src={logoLight.src} width="704" height="190" alt="DR. PIDKUIMUKHA, стоматологічна клініка" />
    </a>
    <div class="site-footer__col">
      <p><a href={phones.booking.href}>{phones.booking.label}</a> <span class="site-footer__note">{phones.booking.note}</span></p>
      <p><a href={phones.city.href}>{phones.city.label}</a> <span class="site-footer__note">{phones.city.note}</span></p>
      <p>{clinic.city}, {clinic.street}</p>
    </div>
    <ul class="site-footer__col" role="list">
      <li><a href={links.telegram} target="_blank" rel="noopener">Telegram</a></li>
      <li><a href={links.instagram} target="_blank" rel="noopener">Instagram</a></li>
      <li><a href={links.facebook} target="_blank" rel="noopener">Facebook</a></li>
    </ul>
    <ul class="site-footer__col" role="list">
      <li><FutureLink note={SOON} arrow={false}>Політика конфіденційності</FutureLink></li>
      <li><FutureLink note={SOON} arrow={false}>Публічна оферта</FutureLink></li>
      <li class="site-footer__lang"><span aria-current="true">UA</span> <span aria-hidden="true">/</span> <FutureLink note={SOON} arrow={false}>EN</FutureLink></li>
    </ul>
    <p class="site-footer__copy">© {clinic.name}, з {clinic.since} року</p>
  </div>
</footer>

<style>
  .site-footer { padding-block: var(--s5) var(--s4); border-top: 1px solid var(--color-muted); font-size: var(--fs-cap); }
  .site-footer__grid { display: grid; gap: var(--s4); }
  .site-footer__logo { display: inline-flex; align-self: start; justify-self: start; min-height: var(--tap); align-items: center; border-radius: var(--radius); }
  .site-footer__logo img { height: 40px; width: auto; }
  .site-footer__col { margin: 0; padding: 0; display: grid; gap: 4px; align-content: start; }
  .site-footer__col p { margin: 0; }
  .site-footer a { display: inline-flex; align-items: center; min-height: var(--tap); color: var(--color-on-dark); text-underline-offset: 4px; }
  .site-footer a:hover { text-decoration-color: var(--color-accent); }
  .site-footer__note { margin-left: var(--s1); }
  .site-footer__lang { display: flex; align-items: center; gap: var(--s1); }
  .site-footer__copy { margin: 0; }
  @media (min-width: 768px) {
    .site-footer__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .site-footer__grid { grid-template-columns: minmax(0, 3fr) minmax(0, 4fr) minmax(0, 2fr) minmax(0, 3fr); column-gap: var(--s3); }
    .site-footer__copy { grid-column: 1 / -1; }
  }
</style>
