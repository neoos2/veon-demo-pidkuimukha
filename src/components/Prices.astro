---
import Button from "./Button.astro";
import FutureLink from "./FutureLink.astro";
import { prices, payment, phones, money, SOON } from "../data/clinic";
---
<section id="prices" class="prices section" aria-labelledby="prices-title">
  <div class="container prices__grid">
    <div class="prices__head">
      <h2 class="h2" id="prices-title">Вартість і оплата</h2>
      <p class="lead">Ціни «від» — з прайсу клініки. Точну вартість називаємо в&nbsp;плані лікування після консультації.</p>
    </div>
    <div class="prices__list" data-rec="UX-R002">
      {prices.map((g) => (
        <div class="pgroup">
          <h3 class="h3 pgroup__title">{g.title}</h3>
          <ul class="pgroup__rows" role="list">
            {g.rows.map((r) => (
              <li class="prow">
                <span class="prow__name">{r.name}</span>
                <span class="prow__sum">від&nbsp;{money(r.from)}&nbsp;₴</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="prices__pay field-accent" data-rec="UX-R009"><span class="prices__pay-label">Оплата:</span> {payment}.</p>
    <div class="prices__actions" data-rec="UX-R008">
      <Button href={phones.booking.href} icon="phone" label={`Подзвонити: ${phones.booking.label}`}>Подзвонити</Button>
      <FutureLink note={SOON}>Повний прайс</FutureLink>
      <a class="text-link" href="#care">Як ми дбаємо про безпеку</a>
    </div>
  </div>
</section>

<style>
  .prices__grid { display: grid; gap: var(--s4); }
  .prices__head { display: grid; gap: var(--s2); align-content: start; }
  .prices__list { display: grid; gap: var(--s4); }
  .pgroup__title { font-weight: 500; font-size: var(--fs-lead); }
  .pgroup__rows { margin: var(--s1) 0 0; padding: 0; }
  .prow {
    display: grid; gap: 2px; padding-block: 12px;
    border-bottom: 1px solid var(--color-muted);
  }
  .prow__name { font-size: var(--fs-body); }
  .prow__sum {
    font-family: var(--font-display); font-weight: 600; font-size: var(--fs-lead); line-height: 1.2;
    font-variant-numeric: lining-nums tabular-nums; white-space: nowrap;
  }
  .prices__pay { margin: 0; padding: var(--s3); border-radius: 0; font-size: var(--fs-body); }
  .prices__pay-label { font-weight: 500; }
  .prices__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s2) var(--s4); }

  @media (min-width: 640px) {
    .prow { grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; gap: var(--s3); }
    .prow__name { font-size: var(--fs-lead); }
    .prow__sum { text-align: right; }
  }
  @media (min-width: 1024px) {
    .prices__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--s3); row-gap: var(--s4); }
    .prices__head { grid-column: 1 / span 4; position: sticky; top: calc(var(--header-h) + var(--s3)); }
    .prices__list, .prices__pay, .prices__actions { grid-column: 6 / span 7; }
    .pgroup { display: grid; grid-template-columns: 9rem minmax(0, 1fr); column-gap: var(--s3); }
    .pgroup__rows { margin: 0; }
    .pgroup__title { padding-top: 12px; }
    .prices__pay { padding: var(--s3) var(--s4); font-size: var(--fs-lead); line-height: 1.45; }
  }
</style>
